        }.alignItems(HorizontalAlign.Start).width('100%').padding(18).backgroundColor('#15263A').borderRadius(16)
        Text('02  é€‰æ‹©å¤„ç†ä»»åŠ¡').fontColor('#69E4CC').fontSize(18)
        ForEach(this.modes, (name: string, index: number) => {
