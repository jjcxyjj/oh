        })
        if (this.mode === 0 || this.mode === 3 || this.mode === 4) {
          Text('EQ é¢„è®¾ï¼ˆâ€œäººå£°æ¸…æ™°â€æ˜¯ EQ åç§°ï¼Œä¸æ˜¯éŸ³æºåˆ†ç¦»ï¼‰').fontColor('#B3C1D2').fontSize(12)
          ForEach(this.presets, (name: string, index: number) => {
